# Replace domains, certificate paths and the shared gateway secret before use.
# Use the SAME secret as NUXT_API_PROXY_SECRET in EdgeOne; never commit its value.
server {
    listen 443 ssl;
    server_name api.example.com;
    ssl_certificate /path/to/fullchain.pem;
    ssl_certificate_key /path/to/privkey.pem;
    client_max_body_size 6m;

    location /api/ {
        if ($http_x_czx_proxy_secret != "REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS") {
            return 403;
        }
        proxy_pass http://127.0.0.1:3200;
        proxy_set_header Host $host;
        # This value was replaced by Nuxt from EdgeOne's trusted client context.
        # Overwrite the chain, do not append the gateway's own remote address.
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Czx-Proxy-Secret "";
        proxy_set_header X-Czx-Client-Ip "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }
    location / { return 404; }
}

server {
    listen 80;
    server_name api.example.com;
    return 301 https://$host$request_uri;
}
