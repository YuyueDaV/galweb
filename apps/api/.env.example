NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3200
WEB_ORIGIN=http://127.0.0.1:3100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=galweb
DB_PASSWORD=
DB_NAME=galweb
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# smtp sends real mail; capture writes private files under .data/mail in development only.
MAIL_TRANSPORT=capture
# QQ/Foxmail: smtp.qq.com, port 465, secure true; SMTP_PASSWORD is the authorization code.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional: raw personal Bangumi token; backend only. Do not add the Bearer prefix.
BANGUMI_ACCESS_TOKEN=
